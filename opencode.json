{
  "$schema": "https://opencode.ai/config.json",
  "command": {
    "test": {
      "template": "php tests/liteTest.php",
      "description": "Ejecutar todos los tests"
    },
    "test-unit": {
      "template": "php tests/liteTest.php",
      "description": "Ejecutar tests unitarios (liteTest)"
    },
    "test-integration": {
      "template": "php tests/liteTest.php",
      "description": "Ejecutar tests de integracion (liteTest)"
    },
    "test-filter": {
      "template": "php tests/liteTest.php",
      "description": "Ejecutar tests por filtro (liteTest no soporta filtro nativamente)",
      "args": ["filtro"]
    },
    "benchmark": {
      "template": "php benchmark.php",
      "description": "Ejecutar benchmarks de rendimiento"
    },
    "migrar": {
      "template": "php servidor/migrar.php",
      "description": "Ejecutar migraciones pendientes"
    },
    "server": {
      "template": "php -S localhost:8000 -t .",
      "description": "Iniciar servidor PHP de desarrollo"
    },
    "lint": {
      "template": "php phpcs.phar --standard=phpcs.xml.dist",
      "description": "Validar codigo con PHPCS (PSR-12)"
    },
    "stan": {
      "template": "php phpstan.phar analyse --configuration=phpstan.neon.dist",
      "description": "Analisis estatico con PHPStan nivel 7"
    },
    "validate": {
      "template": "php phpstan.phar analyse --configuration=phpstan.neon.dist --no-progress && php phpcs.phar --standard=phpcs.xml.dist --extensions=php --ignore=vendor,plantillas,tests --runtime-set ignore_warnings_on_exit 1 . && php tests/liteTest.php",
      "description": "Validacion completa: PHPStan + PHPCS + liteTest"
    },
    "review": {
      "template": "Revisa los cambios recientes en el repositorio y verifica que no haya alucinaciones, código inventado, o inconsistencias con REGLAS.md",
      "description": "Iniciar revisión del verificador sobre cambios recientes",
      "agent": "verificador"
    }
  },
  "agent": {
    "default": {
      "model": "default",
      "temperature": 0.1
    },
    "plan": {
      "temperature": 0.05,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "build": {
      "temperature": 0.15
    },
    "verificador": {
      "mode": "subagent",
      "description": "Verificador crítico — detecta alucinaciones, errores y código inventado",
      "temperature": 0.0,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git diff": "allow",
          "git log*": "allow",
          "git status": "allow",
          "grep *": "allow"
        }
      }
    }
  },
  "default_agent": "default",
  "instructions": [
    "REGLAS.md",
    ".opencode/LITE_MCP.md"
  ],
  "plugin": [".opencode/plugins/enforcer.mjs"]
}
