$consola->registrar('operador:crear', 'Crea un operador en el sistema', function (array $args): int {
    \LiteFramework\Seguridad\ControlAccesoRBAC::requiereTokenIA();
    $consola = Consola::instance();
    $modoJson = $consola && $consola->estaEnModoJson();
    if (!\LiteFramework\Seguridad\ControlAccesoRBAC::esManager()) {
        if ($modoJson) { $consola?->jsonError('Solo managers pueden crear operadores', 'ERR_PERMISO', 403); }
        echo "ERROR: Solo managers pueden crear operadores.\n"; return 1;
    }
    $nombre = $args[0] ?? '';
    $email = $args[1] ?? '';
    $clave = $args[2] ?? '';
    $idRol = 0;
    for ($i = 3; $i < count($args); $i++) {
        if (str_starts_with($args[$i], '--rol=')) { $idRol = (int)substr($args[$i], 6); }
    }
    if (!$nombre || !$email || !$clave) {
        if ($modoJson) { $consola?->jsonError('Faltan argumentos: <nombre> <email> <clave>', 'ERR_ARG', 400); }
        echo "Uso: consola operador:crear <nombre> <email> <clave> [--rol=N]\n"; return 1;
    }
    $validacion = \LiteFramework\Seguridad\PoliticaContrasena::validar($clave);
    if ($validacion !== true) {
        if ($modoJson) { $consola?->jsonError($validacion, 'ERR_VAL', 400); }
        echo "ERROR: $validacion\n"; return 1;
    }
    if (\LiteFramework\Modelos\Operador::donde('correo_electronico', $email)->primero()) {
        if ($modoJson) { $consola?->jsonError('El correo ya esta registrado', 'ERR_DUP', 409); }
        echo "ERROR: El correo $email ya esta registrado.\n"; return 1;
    }
    if ($idRol <= 0) { $idRol = 1; }
    $hash = \LiteFramework\Seguridad\SanitizadorEntrada::encriptarClaveOperador($clave);
    $nuevo = \LiteFramework\Modelos\Operador::crear([
        'nombre_completo' => $nombre,
        'correo_electronico' => $email,
        'clave_acceso' => $hash,
        'id_rol' => $idRol,
        'estado_cuenta' => 1,
    ]);
    if ($modoJson) {
        $consola?->jsonOut(['id' => $nuevo->id_operador, 'email' => $email, 'rol_id' => $idRol], 'operador:crear');
        return 0;
    }
    echo "Operador creado: ID {$nuevo->id_operador} <{$email}>\n";
    return 0;
}, ['<nombre>', '<email>', '<clave>', '[--rol=1]']);

