$consola->registrar('lock:adquirir', 'Adquiere un bloqueo exclusivo (mutex)', function (array $args): int {
    $consola = Consola::instance();
    $modoJson = $consola && $consola->estaEnModoJson();
    $clave = $args[0] ?? '';
    $tiempo = isset($args[1]) ? (int)$args[1] : 30;

    if (!$clave) {
        if ($modoJson) {
            $consola?->jsonError('Se requiere <clave>', 'ERR_ARG', 400);
        }
        echo "Uso: consola lock:adquirir <clave> [tiempo_maximo_seg=30]" . PHP_EOL;
        return 1;
    }

    $exito = \LiteFramework\Nucleo\BloqueoArchivo::adquirir($clave, $tiempo, true);
    if ($modoJson) {
        $consola?->jsonOut(['clave' => $clave, 'adquirido' => $exito, 'tiempo_maximo' => $tiempo], 'lock:adquirir');
        return $exito ? 0 : 1;
    }
    echo $exito ? "Lock adquirido: {$clave}" . PHP_EOL : "Error: no se pudo adquirir lock: {$clave}" . PHP_EOL;
    return $exito ? 0 : 1;
}, ['<clave>', '[tiempo_maximo_seg=30]']);

