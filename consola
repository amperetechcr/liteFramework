$consola->registrar('crud', 'CRUD sobre cualquier tabla de la BD', function (array $args): int {
    \LiteFramework\Seguridad\ControlAccesoRBAC::requiereTokenIA();
    $consola = Consola::instance();
    $modoJson = $consola && $consola->estaEnModoJson();
    $tabla = preg_replace('/[^a-zA-Z_\x80-\xff]/', '', $args[0] ?? '');
    $accion = $args[1] ?? 'listar';
    $dataJson = '';
    $idFiltro = 0;
    for ($i = 2; $i < count($args); $i++) {
        if (str_starts_with($args[$i], '--data=')) { $dataJson = substr($args[$i], 7); }
        if (str_starts_with($args[$i], '--id=')) { $idFiltro = (int)substr($args[$i], 5); }
    }
    if (!$tabla) {
        if ($modoJson) { $consola?->jsonError('Falta <tabla>', 'ERR_ARG', 400); }
        echo "Uso: consola crud <tabla> <accion> [--data=json] [--id=N]\n"; return 1;
    }
    $bd = \LiteFramework\Config\ConexionBaseDatos::obtenerInstancia()->obtenerConector();
    $pkCol = 'id';
    try {
        $pkStmt = $bd->prepare("SHOW KEYS FROM `$tabla` WHERE Key_name = 'PRIMARY'");
        $pkStmt->execute();
        $pkRow = $pkStmt->fetch(PDO::FETCH_ASSOC);
        if ($pkRow && !empty($pkRow['Column_name'])) { $pkCol = $pkRow['Column_name']; }
    } catch (\Throwable) { $pkCol = 'id'; }
    try {
        if ($accion === 'listar') {
            $stmt = $bd->query("SELECT * FROM `$tabla` LIMIT 100");
            $rows = $stmt->fetchAll(PDO::FETCH_ASSOC);
            if ($modoJson) { $consola?->jsonOut(['tabla' => $tabla, 'pk' => $pkCol, 'filas' => count($rows), 'datos' => $rows], 'crud'); }
            else { echo json_encode($rows, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE) . "\n"; }
        } elseif ($accion === 'leer') {
            if (!$idFiltro) { throw new \Exception('--id=N requerido para leer'); }
            $stmt = $bd->prepare("SELECT * FROM `$tabla` WHERE `$pkCol` = ?");
            $stmt->execute([$idFiltro]);
            $row = $stmt->fetch(PDO::FETCH_ASSOC);
            if ($modoJson) { $consola?->jsonOut(['tabla' => $tabla, $pkCol => $idFiltro, 'fila' => $row ?: null], 'crud'); }
            else { echo json_encode($row, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE) . "\n"; }
        } elseif ($accion === 'crear') {
            $data = json_decode($dataJson, true) ?: [];
            if (!$data) { throw new \Exception('--data=json requerido'); }
            $cols = implode('`, `', array_keys($data));
            $vals = implode(', ', array_fill(0, count($data), '?'));
            $stmt = $bd->prepare("INSERT INTO `$tabla` (`$cols`) VALUES ($vals)");
            $stmt->execute(array_values($data));
            $id = $bd->lastInsertId();
            if ($modoJson) { $consola?->jsonOut(['tabla' => $tabla, 'insertado' => $id], 'crud'); }
            else { echo "Insertado ID $id en $tabla\n"; }
        } elseif ($accion === 'actualizar') {
            $data = json_decode($dataJson, true) ?: [];
            if (!$data || !$idFiltro) { throw new \Exception('--data=json e --id=N requeridos'); }
            $sets = implode(', ', array_map(fn($k) => "`$k` = ?", array_keys($data)));
            $stmt = $bd->prepare("UPDATE `$tabla` SET $sets WHERE `$pkCol` = ?");
            $stmt->execute([...array_values($data), $idFiltro]);
            if ($modoJson) { $consola?->jsonOut(['tabla' => $tabla, 'actualizados' => $stmt->rowCount()], 'crud'); }
            else { echo "Actualizados {$stmt->rowCount()} registros en $tabla\n"; }
        } elseif ($accion === 'eliminar') {
            if (!$idFiltro) { throw new \Exception('--id=N requerido'); }
            $stmt = $bd->prepare("DELETE FROM `$tabla` WHERE `$pkCol` = ?");
            $stmt->execute([$idFiltro]);
            if ($modoJson) { $consola?->jsonOut(['tabla' => $tabla, 'eliminados' => $stmt->rowCount()], 'crud'); }
            else { echo "Eliminados {$stmt->rowCount()} registros de $tabla\n"; }
        } else {
            throw new \Exception("Accion no valida: $accion (use: listar, leer, crear, actualizar, eliminar)");
        }
    } catch (\Throwable $e) {
        if ($modoJson) { $consola?->jsonError($e->getMessage(), 'ERR_CRUD', 400); }
        else { echo "ERROR: {$e->getMessage()}\n"; }
        return 1;
    }
    return 0;
}, ['<tabla>', '<accion>', '[--data=json]', '[--id=N]']);

// ─── orquestador IA ───
$consola->registrar('ia:orquestar', 'OrquestadorIA: descubre qué helper/método usar según tu intención. Modos: descubrir (lista por categoría), buscar (encuentra helper), ejecutar (ejecuta directo)',
function (array $args): int {
    \LiteFramework\Seguridad\ControlAccesoRBAC::requiereTokenIA();
    $consola = Consola::instance();
    $modoJson = $consola && $consola->estaEnModoJson();
    $modo = $args[0] ?? 'descubrir';
    $param = $args[1] ?? '';
    $paramsExtra = [];
    for ($i = 2; $i < count($args); $i++) {
        if (str_starts_with($args[$i], '--')) {
            $parts = explode('=', substr($args[$i], 2), 2);
            $paramsExtra[$parts[0]] = $parts[1] ?? true;
        }
    }

    try {
        if ($modo === 'descubrir') {
            $resultado = \LiteFramework\Servicios\OrquestadorIA::catalogo($param ?: null);
        } elseif ($modo === 'buscar') {
            $resultado = \LiteFramework\Servicios\OrquestadorIA::sugerir($param ?: '');
        } elseif ($modo === 'ejecutar') {
            $helper = $paramsExtra['helper'] ?? $param;
            $metodo = $paramsExtra['metodo'] ?? '';
            $data = isset($paramsExtra['params']) ? json_decode($paramsExtra['params'], true) ?? [] : [];
            $resultado = \LiteFramework\Servicios\OrquestadorIA::ejecutar($helper, $metodo, $data);
        } elseif ($modo === 'auto') {
            $data = isset($paramsExtra['params']) ? json_decode($paramsExtra['params'], true) ?? [] : [];
            $resultado = \LiteFramework\Servicios\OrquestadorIA::auto($param ?: $modo, $data);
        } else {
            throw new \InvalidArgumentException("Modo no valido: $modo (use: descubrir, buscar, ejecutar, auto)");
        }

        if ($modoJson) {
            $consola?->jsonOut(['modo' => $modo, 'resultado' => $resultado], 'ia:orquestar');
        } else {
            echo json_encode(['modo' => $modo, 'resultado' => $resultado], JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE) . "\n";
        }
    } catch (\Throwable $e) {
        if ($modoJson) {
            $consola?->jsonError($e->getMessage(), 'ERR_IA', 400);
        } else {
            echo "ERROR: {$e->getMessage()}\n";
        }
        return 1;
    }
    return 0;
}, ['<modo|descubrir|auto>', '[<categoria|intento>]', '[--helper=]', '[--metodo=]', '[--params=json]']);

