$consola->registrar('git:sync', 'Sincroniza todo el proyecto con GitHub via SSH', function (array $args): int {
    $consola = Consola::instance();
    $modoJson = $consola && $consola->estaEnModoJson();
    $pasos = [];
    $salidas = [];
    $gitDir = DIRECTORIO_RAIZ;

    // 1. Remote SSH
    $salidas[] = shell_exec("git -C {$gitDir} remote set-url origin git@github.com:amperetechcr/liteFramework.git 2>&1");
    $pasos[] = 'remote SSH configurado';

    // 2. Add -A (incluye eliminados)
    $salidas[] = shell_exec("git -C {$gitDir} add -A 2>&1");
    $pasos[] = 'stage completo';

    // 3. Commit
    $salidas[] = shell_exec("git -C {$gitDir} commit -m \"sync: 100% del proyecto local\" 2>&1");
    $pasos[] = 'commit realizado';

    // 4. Push
    $salidas[] = shell_exec("git -C {$gitDir} push -u origin beta 2>&1");
    $pasos[] = 'push realizado';

    if ($modoJson) {
        $consola?->jsonOut([
            'pasos' => $pasos,
            'salidas' => $salidas,
        ], 'git:sync');
        return 0;
    }
    foreach ($pasos as $i => $p) {
        echo "[$i] $p\n";
    }
    return 0;
});

