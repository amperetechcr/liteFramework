$consola->registrar('diagnostico:remediar', 'Ejecuta reparación automática para un problema', function (array $args): int {
    \LiteFramework\Seguridad\ControlAccesoRBAC::requiereTokenIA();
    if (!\LiteFramework\Seguridad\ControlAccesoRBAC::esManager()) {
        $consola = Consola::instance();
        if ($consola && $consola->estaEnModoJson()) {
            $consola->jsonError('Workers no pueden ejecutar reparaciones', 'ERR_PERMISO', 403);
        }
        echo "ERROR: Solo los agentes Manager pueden ejecutar reparaciones." . PHP_EOL;
        return 1;
    }
    $consola = Consola::instance();
    $modoJson = $consola && $consola->estaEnModoJson();
    $tipo = $args[0] ?? '';
    $params = [];

    for ($i = 1; $i < count($args); $i++) {
        if (str_starts_with($args[$i], '--')) {
            $parts = explode('=', substr($args[$i], 2), 2);
            $params[$parts[0]] = $parts[1] ?? true;
        }
    }

    if (!$tipo) {
        if ($modoJson) {
            $consola?->jsonError('Se requiere <tipo> (ej: directorio_no_creable)', 'ERR_ARG', 400);
        }
        echo "Uso: consola diagnostico:remediar <tipo> [--clave=valor]\n";
        return 1;
    }

    $resultado = \LiteFramework\Servicios\RemediadorError::ejecutarReparacion($tipo, $params);
    if ($modoJson) {
        $consola?->jsonOut($resultado, 'diagnostico:remediar');
        return !empty($resultado['exito']) ? 0 : 1;
    }
    echo !empty($resultado['exito'])
        ? "Reparación aplicada: {$resultado['mensaje']}\n"
        : "Error: {$resultado['mensaje']}\n";
    return !empty($resultado['exito']) ? 0 : 1;
}, ['<tipo>', '[--param=valor...]']);

