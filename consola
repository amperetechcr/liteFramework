$consola->registrar('ssh:gen-key', 'Genera SSH key y muestra clave publica para GitHub', function (array $args): int {
    $consola = Consola::instance();
    $modoJson = $consola && $consola->estaEnModoJson();
    $sshDir = (getenv('USERPROFILE') ?: getenv('HOME')) . '/.ssh';
    $keyFile = $sshDir . '/id_rsa';
    $pubFile = $keyFile . '.pub';
    if (!is_dir($sshDir)) {
        mkdir($sshDir, 0700, true);
    }
    if (!file_exists($keyFile)) {
        $output = shell_exec('ssh-keygen -t rsa -b 4096 -f ' . escapeshellarg($keyFile) . ' -N "" 2>&1');
    }
    $pub = file_get_contents($pubFile);
    if ($modoJson) {
        $consola?->jsonOut([
            'clave_publica' => trim($pub),
            'mensaje' => 'Agregala en GitHub Settings > SSH and GPG keys > New SSH key',
        ], 'ssh:gen-key');
        return 0;
    }
    echo "=== CLAVE PUBLICA SSH ===\n";
    echo "Agregala en: GitHub Settings > SSH and GPG keys > New SSH key\n\n";
    echo $pub . "\n";
    echo "========================\n";
    return 0;
});

