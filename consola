$consola->registrar('auditoria:exportar', 'Exporta eventos de auditoría en JSON o CSV', function (array $args): int {
    $consola = Consola::instance();
    $modoJson = $consola && $consola->estaEnModoJson();
    $formato = 'json';
    $filtros = [];

    for ($i = 0; $i < count($args); $i++) {
        if ($args[$i] === '--formato' && isset($args[$i + 1])) {
            $formato = $args[++$i];
        } elseif (str_starts_with($args[$i], '--formato=')) {
            $formato = substr($args[$i], 10);
        } elseif (str_starts_with($args[$i], '--nivel=')) {
            $filtros['nivel'] = substr($args[$i], 8);
        } elseif (str_starts_with($args[$i], '--modulo=')) {
            $filtros['modulo'] = substr($args[$i], 9);
        } elseif (str_starts_with($args[$i], '--desde=')) {
            $filtros['fecha_desde'] = substr($args[$i], 8);
        } elseif (str_starts_with($args[$i], '--hasta=')) {
            $filtros['fecha_hasta'] = substr($args[$i], 8);
        } elseif (str_starts_with($args[$i], '--ip=')) {
            $filtros['ip'] = substr($args[$i], 5);
        } elseif (str_starts_with($args[$i], '--busqueda=')) {
            $filtros['busqueda'] = substr($args[$i], 11);
        } elseif (str_starts_with($args[$i], '--limite=')) {
            $filtros['limite'] = (int)substr($args[$i], 9);
        }
    }

    $exportado = \LiteFramework\Seguridad\RegistroAuditoria::exportarEventos(
        $formato,
        null,
        $filtros['modulo'] ?? null,
        $filtros['fecha_desde'] ?? null,
        $filtros['fecha_hasta'] ?? null,
        $filtros['nivel'] ?? null,
        $filtros['ip'] ?? null,
        $filtros['busqueda'] ?? null,
        $filtros['limite'] ?? 10000
    );

    if ($modoJson && $formato === 'json') {
        echo $exportado . PHP_EOL;
    } elseif ($modoJson) {
        $consola?->jsonOut(['eventos_csv' => $exportado, 'total' => substr_count($exportado, "\n") - 1], 'auditoria:exportar');
    } else {
        echo $exportado . PHP_EOL;
    }
    return 0;
}, ['[--formato=json|csv]', '[--nivel=INFO|ERROR|...]', '[--modulo=]', '[--desde=]', '[--hasta=]', '[--ip=]', '[--busqueda=]', '[--limite=10000]']);

