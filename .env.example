# =============================================
# LITE FRAMEWORK - Configuracion de entorno
# =============================================
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas .env al repositorio.

# Entorno: desarrollo | pruebas | produccion
APP_ENTORNO=desarrollo
APP_DEPURACION=true

# Base de datos
DB_ANFITRION=localhost
DB_NOMBRE=lite
DB_USUARIO=root
DB_CLAVE=

# Seguridad
# Limite de intentos de acceso antes del bloqueo
APP_MAX_INTENTOS_ACCESO=5
# Minutos de bloqueo tras exceder intentos
APP_BLOQUEO_MINUTOS=15

# OAuth — URL base para redirects (cambiar si usas tunnel)
# Si usas cloudflared: https://<tunel>.trycloudflare.com
# Si usas ngrok: https://<hash>.ngrok-free.dev
# Local: http://localhost/liteFramework
OAUTH_REDIRECT_BASE=http://localhost/liteFramework

# --- Correo SMTP ---
MAIL_ANFITRION=localhost
MAIL_PUERTO=25
MAIL_USUARIO=
MAIL_CLAVE=
MAIL_REMITENTE=
MAIL_TLS=false

# --- OAuth ---
OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=
OAUTH_GITHUB_ID=
OAUTH_GITHUB_SECRET=

# --- Sentry ---
# https://sentry.io
SENTRY_DSN=https://clave_publica@host/project_id

# --- AI Crew ---
# Hash SHA-256 del token que los agentes IA usan para autenticarse en el CLI
# Generar con: php -r "echo hash('sha256', 'tu_secreto');"
AI_CREW_TOKEN_HASH=
# Rol por defecto del agente: manager (escritura total) | worker (solo lectura)
AI_AGENT_ROLE=worker
