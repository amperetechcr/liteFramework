# Force LF line endings for PHP files (PSR-12 / PHPCS requirement)
*.php text eol=lf

# Binary files
*.phar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary

# Auto-detect for everything else
* text=auto
