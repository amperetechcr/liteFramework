parameters:
    level: 0
    paths:
        - .
    scanFiles:
        - servidor/autoload.php
    excludePaths:
        - plantillas/
        - tests/
        - src/modulos/*.php
        - src/vistas/*.php
        - src/modulos/*/*.php
    ignoreErrors:
        - '#Instantiated class [A-Z][a-zA-Z\\]+ not found#'
        - '#Unsafe usage of new static\(\)#'
