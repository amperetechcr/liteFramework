parameters:
    level: 0
    paths:
        - .
    scanFiles:
        - servidor/autoload.php
    excludePaths:
        - plantillas/
        - tests/
        - src/
    ignoreErrors:
        - '#on an unknown class#'
        - '#Instantiated class [A-Z][a-zA-Z\\]+ not found#'
        - '#Unsafe usage of new static\(\)#'
